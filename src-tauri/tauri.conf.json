{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil",
  "version": "0.1.0",
  "identifier": "dev.veil.client",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veil",
        "width": 1180,
        "height": 760,
        "minWidth": 940,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#0a0c0e",
        "dragDropEnabled": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Network",
    "shortDescription": "Veil proxy client",
    "longDescription": "A Linux desktop proxy client powered by sing-box.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"],
    "resources": ["resources/*"],
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {}
}
