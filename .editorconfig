root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# rustfmt defaults: 4 spaces, 100-column width.
[*.rs]
indent_size = 4
max_line_length = 100

[*.{js,jsx,ts,tsx,svelte,css,scss,html,json,yml,yaml,toml}]
indent_size = 2

# Markdown keeps hard line breaks meaningful; do not strip trailing spaces.
[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
indent_size = 4

[*.sh]
indent_size = 2
